  "localization": {
    "th_eligible": {
      "english": "Requires a surveyed uncolonized world inside your borders, allowed size, no anomaly, archaeology, protected story status, attached megastructure or special/unknown deposit. Ordinary orbital deposits use native terraforming rules; no extra resource grants.",
      "russian": "Требуется изученный незаселённый мир в ваших границах, допустимого размера, без аномалии, археологии, защищённого сюжета, прикреплённого мегасооружения и особых/неизвестных месторождений. Обычные орбитальные месторождения обрабатываются штатным терраформированием; дополнительных ресурсов мод не выдаёт."
    },
    "th_title": {
      "english": "Telluric Horizons — Planetary Engineering",
      "russian": "Telluric Horizons — Планетарная инженерия"
    },
    "th_surveyed": {
      "english": "The world must be surveyed.",
      "russian": "Мир должен быть полностью изучен."
    },
    "th_borders": {
      "english": "The world must be inside your borders.",
      "russian": "Мир должен находиться в ваших границах."
    },
    "th_uncolonized": {
      "english": "Engineering requires an uncolonized world.",
      "russian": "Для инженерии требуется незаселённый мир."
    },
    "th_size": {
      "english": "Allowed size: $TH_MIN_SIZE$–$TH_MAX_SIZE$ (gameplay filter, not gravity).",
      "russian": "Допустимый размер: $TH_MIN_SIZE$–$TH_MAX_SIZE$ (игровой фильтр, не гравитация)."
    },
    "th_investigation": {
      "english": "Anomalies and archaeological sites must be absent.",
      "russian": "На мире не должно быть аномалий и археологических объектов."
    },
    "th_story": {
      "english": "Protected, sacred and listed story worlds are excluded.",
      "russian": "Защищённые, священные и перечисленные сюжетные миры исключены."
    },
    "th_deposits": {
      "english": "Special or unknown deposits require a dedicated preservation rule.",
      "russian": "Для особых или неизвестных месторождений требуется отдельное правило сохранения."
    },
    "th_megastructure": {
      "english": "No megastructure may be attached to this world; gateways elsewhere in the system are allowed.",
      "russian": "К этому миру не должно быть прикреплено мегасооружение; врата в другой части системы допустимы."
    }
  }
}
